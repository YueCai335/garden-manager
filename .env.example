# Local Docker Compose and AI configuration.
DATABASE_URL=postgresql+psycopg://garden@localhost:5433/garden_planner
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# AI Garden Note has its own provider and model (ADR-0058); AI_PROVIDER and
# OPENAI_MODEL above apply to Plant Health.
CARE_NOTE_AI_PROVIDER=ollama
CARE_NOTE_OPENAI_MODEL=gpt-4o-mini-2024-07-18

# Local frontend configuration.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public demo only (ADR-0059): "true" lets this build show live AI Garden Note
# drafts when the API allows them. Read at build time; the local app ignores it.
NEXT_PUBLIC_CARE_NOTE_LIVE_ENTRY=false

# Public portfolio-demo configuration. Configure these values in Render and
# Vercel dashboards instead of committing them to Git.
FRONTEND_ORIGINS=https://your-project.vercel.app
PORTFOLIO_DEMO_MODE=false
# Public AI Garden Note (ADR-0059). Render sets CARE_NOTE_AI_PROVIDER=openai;
# keep the local provider above on ollama so a copied file never spends money.
CARE_NOTE_PUBLIC_ENABLED=false
CARE_NOTE_PUBLIC_RUN_LIMIT=0
